 "duration": 13.871,
 "text": "確実な人のところに、仕事は集まっていく。増えた仕事もまた、静かにこなされていく。そして、こなせばこなすほど、それは「当たり前」として、記憶に残らなくなっていきます。",
 "phrases": [
  {
   "text": "確実な",
   "start": 0.2,
   "end": 0.62
  },
  {
   "text": "人の",
   "start": 0.62,
   "end": 0.92
  },
  {
   "text": "ところに、",
   "start": 0.92,
   "end": 1.46
  },
  {
   "text": "仕事は",
   "start": 1.78,
   "end": 2.18
  },
  {
   "text": "集まっていく。",
   "start": 2.18,
   "end": 3.19
  },
  {
   "text": "増えた",
   "start": 3.86,
   "end": 4.14
  },
  {
   "text": "仕事もまた、",
   "start": 4.14,
   "end": 5.0
  },
  {
   "text": "静かに",
   "start": 5.3,
   "end": 5.72
  },
  {
   "text": "こなされていく。",
   "start": 5.8,
   "end": 6.32
  },
  {
   "text": "そして、",
   "start": 7.52,
   "end": 7.82
  },
  {
   "text": "こなせばこなすほど、",
   "start": 8.2,
   "end": 9.3
  },
  {
   "text": "それは",
   "start": 9.86,
   "end": 9.9
  },
  {
   "text": "「当たり前」と",
   "start": 9.9,
   "end": 11.24
  },
  {
   "text": "して、",
   "start": 11.24,
   "end": 11.54
  },
  {
   "text": "記憶に",
   "start": 12.0,
   "end": 12.34
  },
  {
   "text": "残らなくなっていきます。",
   "start": 12.34,
   "end": 13.49
  }
