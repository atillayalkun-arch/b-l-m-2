{
 "id": 9,
 "audio": "9.mp3",
 "duration": 35.239,
 "text": "思い出しやすいものほど、数が多い、よく起きている、と判断してしまう。この傾向には、「利用可能性ヒューリスティック」という名前がついています。評価する人も、記憶の中から例を探します。あの人は、どんな仕事をしていたか。けれど、防がれた問題は、思い出せる例を何も残しません。半年前に静かに防がれた事故より、先週派手に消された火事のほうが、記憶に鮮明に残る。人は、思い出せた仕事にしか、点をつけられないのです。",
 "phrases": [
  {
   "text": "思い出しやすい",
   "start": 0.16,
   "end": 0.86
  },
  {
   "text": "もの",
   "start": 0.86,
   "end": 1.0
  },
  {
   "text": "ほど、",
   "start": 1.0,
   "end": 1.38
  },
  {
   "text": "数が",
   "start": 1.84,
   "end": 2.1
  },
  {
   "text": "多い、",
   "start": 2.1,
   "end": 2.38
  },
  {
   "text": "よく",
   "start": 2.92,
   "end": 3.16
  },
  {
   "text": "起きている、と",
   "start": 3.16,
   "end": 4.16
  },
  {
   "text": "判断してしまう。",
   "start": 4.16,
   "end": 5.34
  },
  {
   "text": "この",
   "start": 5.94,
   "end": 6.08
  },
  {
   "text": "傾向には、",
   "start": 6.08,
   "end": 7.21
  },
  {
   "text": "「利用",
   "start": 7.21,
   "end": 7.54
  },
  {
   "text": "可能性ヒューリスティック」と",
   "start": 7.54,
   "end": 9.387
  },
  {
   "text": "いう",
   "start": 9.387,
   "end": 9.48
  },
  {
   "text": "名前が",
   "start": 9.48,
   "end": 9.98
  },
  {
   "text": "ついています。",
   "start": 10.02,
   "end": 10.32
  },
  {
   "text": "評価する",
   "start": 11.72,
   "end": 12.16
  },
  {
   "text": "人も、",
   "start": 12.16,
   "end": 12.62
  },
  {
   "text": "記憶の",
   "start": 13.02,
   "end": 13.36
  },
  {
   "text": "中から",
   "start": 13.36,
   "end": 13.78
  },
  {
   "text": "例を",
   "start": 13.78,
   "end": 14.2
  },
  {
   "text": "探します。",
   "start": 14.2,
   "end": 14.64
  },
  {
   "text": "あの",
   "start": 15.68,
   "end": 15.86
  },
  {
   "text": "人は、",
   "start": 15.86,
   "end": 16.36
  },
  {
   "text": "どんな",
   "start": 16.6,
   "end": 16.88
  },
  {
   "text": "仕事を",
   "start": 16.88,
   "end": 17.34
  },
  {
   "text": "していたか。",
   "start": 17.34,
   "end": 17.78
  },
  {
   "text": "けれど、",
   "start": 18.98,
   "end": 19.24
  },
  {
   "text": "防がれた",
   "start": 19.62,
   "end": 19.98
  },
  {
   "text": "問題は、",
   "start": 19.98,
   "end": 20.64
  },
  {
   "text": "思い出せる",
   "start": 21.1,
   "end": 21.58
  },
  {
   "text": "例を",
   "start": 21.58,
   "end": 21.92
  },
  {
   "text": "何も",
   "start": 21.96,
   "end": 22.32
  },
  {
   "text": "残しません。",
   "start": 22.32,
   "end": 22.82
  },
  {
   "text": "半年前に",
   "start": 24.06,
   "end": 24.76
  },
  {
   "text": "静かに",
   "start": 24.76,
   "end": 25.3
  },
  {
   "text": "防がれた",
   "start": 25.3,
   "end": 25.84
  },
  {
   "text": "事故より、",
   "start": 25.86,
   "end": 26.36
  },
  {
   "text": "先週派手に",
   "start": 26.88,
   "end": 27.6
  },
  {
   "text": "消された",
   "start": 27.6,
   "end": 28.02
  },
  {
   "text": "火事の",
   "start": 28.02,
   "end": 28.4
  },
  {
   "text": "ほうが、",
   "start": 28.4,
   "end": 28.82
  },
  {
   "text": "記憶に",
   "start": 29.16,
   "end": 29.48
  },
  {
   "text": "鮮明に",
   "start": 29.48,
   "end": 30.06
  },
  {
   "text": "残る。",
   "start": 30.06,
   "end": 30.64
  },
  {
   "text": "人は、",
   "start": 31.34,
   "end": 31.76
  },
  {
   "text": "思い出せた",
   "start": 32.16,
   "end": 32.66
  },
  {
   "text": "仕事にしか、",
   "start": 32.66,
   "end": 33.42
  },
  {
   "text": "点を",
   "start": 33.72,
   "end": 34.02
  },
  {
   "text": "つけられないのです。",
   "start": 34.02,
   "end": 35.07
  }
