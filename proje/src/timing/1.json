{
 "id": 1,
 "audio": "1.mp3",
 "duration": 33.149,
 "text": "トラブルがひとつもなかった一か月。月報に、何を書きますか。「特になし」。そう書いたことがある人は、少なくないはずです。けれど、その「特になし」の裏には、たいてい誰かの仕事があります。ある有名な実験があります。パスの回数を数えることに夢中になった人たちの目の前を、ゴリラの着ぐるみが横切っていく。立ち止まって、胸までたたいたのに、およそ半分の人が、そのゴリラにまったく気づきませんでした。",
 "phrases": [
  {
   "text": "トラブルが",
   "start": 0.14,
   "end": 0.58
  },
  {
   "text": "ひとつも",
   "start": 0.58,
   "end": 1.06
  },
  {
   "text": "なかった",
   "start": 1.06,
   "end": 1.48
  },
  {
   "text": "一か月。",
   "start": 1.62,
   "end": 1.98
  },
  {
   "text": "月報に、",
   "start": 3.18,
   "end": 4.04
  },
  {
   "text": "何を",
   "start": 4.1,
   "end": 4.32
  },
  {
   "text": "書きますか。",
   "start": 4.32,
   "end": 4.74
  },
  {
   "text": "「特になし」。",
   "start": 5.74,
   "end": 6.52
  },
  {
   "text": "そう",
   "start": 7.46,
   "end": 7.56
  },
  {
   "text": "書いたことがある",
   "start": 7.56,
   "end": 8.4
  },
  {
   "text": "人は、",
   "start": 8.46,
   "end": 8.84
  },
  {
   "text": "少なくないはずです。",
   "start": 9.14,
   "end": 10.3
  },
  {
   "text": "けれど、",
   "start": 11.04,
   "end": 11.44
  },
  {
   "text": "その",
   "start": 11.96,
   "end": 12.02
  },
  {
   "text": "「特になし」の",
   "start": 12.02,
   "end": 13.56
  },
  {
   "text": "裏には、",
   "start": 13.56,
   "end": 14.04
  },
  {
   "text": "たいてい",
   "start": 14.54,
   "end": 14.88
  },
  {
   "text": "誰かの",
   "start": 14.88,
   "end": 15.38
  },
  {
   "text": "仕事が",
   "start": 15.38,
   "end": 15.88
  },
  {
   "text": "あります。",
   "start": 15.88,
   "end": 15.98
  },
  {
   "text": "ある",
   "start": 17.26,
   "end": 17.44
  },
  {
   "text": "有名な",
   "start": 17.44,
   "end": 18.1
  },
  {
   "text": "実験が",
   "start": 18.1,
   "end": 18.54
  },
  {
   "text": "あります。",
   "start": 18.54,
   "end": 18.72
  },
  {
   "text": "パスの",
   "start": 19.84,
   "end": 20.2
  },
  {
   "text": "回数を",
   "start": 20.2,
   "end": 20.76
  },
  {
   "text": "数えることに",
   "start": 20.76,
   "end": 21.5
  },
  {
   "text": "夢中に",
   "start": 21.5,
   "end": 21.97
  },
  {
   "text": "なった",
   "start": 21.97,
   "end": 22.3
  },
  {
   "text": "人たちの",
   "start": 22.3,
   "end": 22.8
  },
  {
   "text": "目の前を、",
   "start": 22.8,
   "end": 23.42
  },
  {
   "text": "ゴリラの",
   "start": 23.86,
   "end": 24.28
  },
  {
   "text": "着ぐるみが",
   "start": 24.28,
   "end": 24.88
  },
  {
   "text": "横切っていく。",
   "start": 24.88,
   "end": 25.79
  },
  {
   "text": "立ち止まって、",
   "start": 26.64,
   "end": 27.3
  },
  {
   "text": "胸まで",
   "start": 27.7,
   "end": 28.0
  },
  {
   "text": "たたいたのに、",
   "start": 28.08,
   "end": 28.7
  },
  {
   "text": "およそ半分の",
   "start": 29.24,
   "end": 30.02
  },
  {
   "text": "人が、",
   "start": 30.02,
   "end": 30.38
  },
  {
   "text": "その",
   "start": 30.92,
   "end": 30.94
  },
  {
   "text": "ゴリラに",
   "start": 30.94,
   "end": 31.44
  },
  {
   "text": "まったく",
   "start": 31.48,
   "end": 31.96
  },
  {
   "text": "気づきませんでした。",
   "start": 32.0,
   "end": 32.64
  }
